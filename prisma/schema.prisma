generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PatientProfile {
  id            String         @id @default(cuid())
  clerkId       String         @unique
  firstName     String
  lastName      String
  email         String         @unique
  phone         String?
  dob           DateTime?
  sex           String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  appointments  Appointment[]
  consultations Consultation[]
  prescriptions Prescription[]
}

model PhysicianProfile {
  id            String         @id @default(cuid())
  clerkId       String         @unique
  firstName     String
  lastName      String
  email         String         @unique
  specialty     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  appointments  Appointment[]
  consultations Consultation[]
  prescriptions Prescription[]
}

model StaffProfile {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  firstName String
  lastName  String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Appointment {
  id           String            @id @default(cuid())
  date         DateTime?
  status       AppointmentStatus @default(PENDING)
  reason       String?
  cancelReason String?
  patientId    String
  physicianId  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  patient      PatientProfile    @relation(fields: [patientId], references: [id])
  physician    PhysicianProfile? @relation(fields: [physicianId], references: [id])
  consultation Consultation?
}

model Consultation {
  id            String           @id @default(cuid())
  symptoms      String?
  diagnosis     String?
  advice        String?
  appointmentId String           @unique
  patientId     String
  physicianId   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  appointment   Appointment      @relation(fields: [appointmentId], references: [id])
  patient       PatientProfile   @relation(fields: [patientId], references: [id])
  physician     PhysicianProfile @relation(fields: [physicianId], references: [id])
  prescriptions Prescription[]
}

model Prescription {
  id              String           @id @default(cuid())
  medicineDetails String
  instructions    String?
  pdfUrl          String?
  consultationId  String
  patientId       String
  physicianId     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  consultation    Consultation     @relation(fields: [consultationId], references: [id])
  patient         PatientProfile   @relation(fields: [patientId], references: [id])
  physician       PhysicianProfile @relation(fields: [physicianId], references: [id])
}

enum Role {
  PATIENT
  PHYSICIAN
  STAFF
}

enum AppointmentStatus {
  PENDING
  ACCEPTED
  CHECKED_IN
  COMPLETED
  CANCELLED
  SCHEDULED
  NO_SHOW
}
