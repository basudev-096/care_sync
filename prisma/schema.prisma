// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  PHYSICIAN
  STAFF
}

enum AppointmentStatus {
  PENDING     // 3.1.1 requested by patient, no slot yet
  SCHEDULED   // 3.2.2 staff assigned a date/time, awaiting patient acceptance
  ACCEPTED    // 3.1.3 patient accepted the assigned slot
  CHECKED_IN  // 3.4.2 patient has arrived
  COMPLETED   // 3.5.2 consultation finished
  CANCELLED   // 3.2.5 / 3.3.1 / 3.5.1
  NO_SHOW     // 3.4.3 patient did not arrive
}

model PatientProfile {
  id        String    @id @default(cuid())
  clerkId   String    @unique
  firstName String
  lastName  String
  email     String    @unique
  phone     String?
  dob       DateTime?
  sex       String?

  appointments  Appointment[]
  consultations Consultation[]
  prescriptions Prescription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PhysicianProfile {
  id        String  @id @default(cuid())
  clerkId   String  @unique
  firstName String
  lastName  String
  email     String  @unique
  specialty String?

  appointments  Appointment[]
  consultations Consultation[]
  prescriptions Prescription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StaffProfile {
  id        String @id @default(cuid())
  clerkId   String @unique
  firstName String
  lastName  String
  email     String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Appointment {
  id           String            @id @default(cuid())
  date         DateTime?
  status       AppointmentStatus @default(PENDING)
  reason       String?
  cancelReason String?

  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id])

  physicianId String?
  physician   PhysicianProfile? @relation(fields: [physicianId], references: [id])

  consultation Consultation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Consultation {
  id        String  @id @default(cuid())
  symptoms  String?
  diagnosis String?
  advice    String?

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id])

  physicianId String
  physician   PhysicianProfile @relation(fields: [physicianId], references: [id])

  prescriptions Prescription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Prescription {
  id              String  @id @default(cuid())
  medicineDetails String
  instructions    String?
  pdfUrl          String?

  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id])

  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id])

  physicianId String
  physician   PhysicianProfile @relation(fields: [physicianId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
